{
  "type": "module",
  "name": "mpg_academy",
  "version": "1.0.0",
  "description": "MPG Academy",
  "scripts": {
    "dev": "gulp",
    "build": "gulp styleRoot styleAdmin",
    "deploy": "gulp styleRoot styleAdmin && node --use-system-ca scripts/deploy.mjs",
    "deploy:check": "node --use-system-ca scripts/deploy.mjs --check",
