# Modelo do arquivo .env.deploy (copie para a RAIZ do projeto com esse nome).
#
# .env.deploy fica fora do Git de propósito: este repositório é público, e senha em commit
# vale como senha vazada. Se alguma já foi parar num commit, troque no painel da KingHost.

# Use o nome do SERVIDOR, não ftp.mpgacademy.com.br: o certificado da KingHost é o coringa
# *.uni5.net, e é com o nome do servidor que a verificação fecha. Descubra o seu com
# `nslookup ftp.seudominio.com.br` — a resposta é algo como web2f01.uni5.net.
FTP_HOST=web2f01.uni5.net
FTP_USER=mpgacademy
FTP_PASS=coloque-a-senha-aqui

# Pasta pública no servidor. Na KingHost é /www.
FTP_DIR=/www

# FTPS explícito. Se der erro de certificado/conexão, troque para false.
FTP_SECURE=true
